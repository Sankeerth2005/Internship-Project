# =============================================================================
# Vocal For Sanatan — SINGLE source of truth (repo root .env only)
# =============================================================================
# Public edge = ngrok FREE tunnel to localhost:5138
# No IIS, no Cloudflare, no reverse proxy on the manager PC.
#
# Free ngrok CANNOT bind api.vocalforsanatan.com / app.vocalforsanatan.com.
# Those GoDaddy names need a paid ngrok plan (CNAME) or a different host.
# On free: API_HOST = your assigned *.ngrok-free.app (or *.ngrok-free.dev) host.
# =============================================================================

# --- Set on manager process only (do not rely on these in shared git) ---
# ASPNETCORE_ENVIRONMENT=Development
# ASPNETCORE_URLS=http://0.0.0.0:5138

# --- After Start-Ngrok.ps1, replace YOUR-DEV-DOMAIN with the printed host ---
BACKEND_API_URL=https://YOUR-DEV-DOMAIN.ngrok-free.app/api
API_HOST=YOUR-DEV-DOMAIN.ngrok-free.app
API_USE_HTTPS=true
API_ALLOW_INSECURE=false

# GoDaddy marketing URLs (optional; not the API host on free ngrok)
API_PUBLIC_URL=https://YOUR-DEV-DOMAIN.ngrok-free.app
APP_PUBLIC_URL=https://vocalforsanatan.com
CORS_ALLOWED_ORIGINS=https://www.vocalforsanatan.com;https://vocalforsanatan.com;https://YOUR-DEV-DOMAIN.ngrok-free.app

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# --- Database ---
DB_CONNECTION_STRING=Data Source=localhost\SQLEXPRESS;Database=LocalinkDb;Integrated Security=True;Pooling=True;Max Pool Size=200;Encrypt=True;TrustServerCertificate=True;Command Timeout=30

# --- JWT ---
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=LocalinkAPI
JWT_AUDIENCE=LocalinkUsers
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=3650

# --- Email ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_APP_NAME=Vocal For Sanatan
ADMIN_EMAIL=

# --- Third-party ---
COUNTRY_CSC_API_KEY=
GEOAPIFY_API_KEY=
GROQ_API_KEY=
CURRENCY_CONVERTER_API_KEY=a250538e5953eece5a75047c

# --- Uploads ---
UPLOADS_PATH=C:\LocalinkUploads
